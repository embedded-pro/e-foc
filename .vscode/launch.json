{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Linux Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DISPLAY",
                    "value": "host.docker.internal:0.0"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerArgs": "-iex \"set debuginfod urls\"",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Simulator GUI",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/host/tools/simulator/app/Debug/e_foc.tool.simulator",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DISPLAY",
                    "value": "host.docker.internal:0.0"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerArgs": "-iex \"set debuginfod urls\"",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Hardware Bridge GUI",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/host/tools/hardware_bridge/client/gui/main/Debug/e_foc.tool.hardware_bridge.bridge_client_gui",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DISPLAY",
                    "value": "host.docker.internal:0.0"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerArgs": "-iex \"set debuginfod urls\"",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "CAN Commander (Docker)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/host/tools/can_commander/main/Debug/e-foc-can-commander",
            "args": ["--no-update-check"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DISPLAY",
                    "value": "host.docker.internal:0.0"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerArgs": "-iex \"set debuginfod urls\"",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Embedded Debug",
            "cwd": "${workspaceFolder}",
            "executable": "${command:cmake.launchTargetPath}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "external",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "both",
            "gdbTarget": "host.docker.internal:2334",
            "overrideLaunchCommands": [
                "monitor reset",
                "-target-download",
                "monitor reset"
            ],
            "overrideRestartCommands": [
                "monitor reset"
            ]
        },
        {
            "name": "HIL Tests",
            "type": "cppdbg",
            "request": "launch",
            "preLaunchTask": "Build HIL tests",
            "program": "${workspaceFolder}/build/host/integration_tests/main/${input:hilBuildType}/e_foc.integration_tests",
            "args": [
                "--mode",
                "hil",
                "--bridge-host",
                "host.docker.internal",
                "--serial-port",
                "${input:hilSerialPort}",
                "--can-port",
                "${input:hilCanPort}",
                "--gdb-exe",
                "/usr/bin/gdb-multiarch",
                "--gdb-target",
                "host.docker.internal:${input:hilGdbPort}",
                "--firmware-elf",
                "${workspaceFolder}/build/${input:boardType}/targets/hardware_test/main/${input:hilBuildType}/e_foc.hardware_test.main.elf",
                "${workspaceFolder}/integration_tests/features",
                "-t",
                "@hil or @hil_motor"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerArgs": "-iex \"set debuginfod urls\"",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ],
    "inputs": [
        {
            "id": "boardType",
            "type": "pickString",
            "description": "Select board type for HIL tests and target firmware",
            "options": [
                "EK-TM4C1294XL",
                "EK-TM4C123GXL",
                "STM32F407G-DISC1",
                "NUCLEO-H563ZI"
            ],
            "default": "EK-TM4C1294XL"
        },
        {
            "id": "hilBuildType",
            "type": "pickString",
            "description": "Select build type for HIL tests and target firmware",
            "options": [
                "Debug",
                "Release",
                "RelWithDebInfo",
                "MinSizeRel"
            ],
            "default": "Debug"
        },
        {
            "id": "hilSerialPort",
            "type": "promptString",
            "description": "Hardware bridge serial port",
            "default": "5000"
        },
        {
            "id": "hilCanPort",
            "type": "promptString",
            "description": "Hardware bridge CAN port",
            "default": "5001"
        },
        {
            "id": "hilGdbPort",
            "type": "promptString",
            "description": "GDB server port on host.docker.internal",
            "default": "2334"
        }
    ]
}
