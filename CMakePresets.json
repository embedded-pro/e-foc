{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "defaults",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "On",
                "CMAKE_COMPILE_WARNING_AS_ERROR": "On",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "E_FOC_EMBEDDED_BUILD": false
            }
        },
        {
            "name": "host",
            "displayName": "Configuration for Host Tooling and Tests",
            "inherits": "defaults",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo;MinSizeRel",
                "E_FOC_TARGET_PLATFORM": "host",
                "E_FOC_BUILD_TESTS": true,
                "E_FOC_BUILD_HIL_TESTS": true,
                "E_FOC_BUILD_SIMULATOR": true,
                "NUMERICAL_TOOLBOX_ENABLE_OPTIMIZATIONS": false
            },
            "generator": "Ninja Multi-Config"
        },
        {
            "name": "host-single-Debug",
            "displayName": "Configuration for Host Tooling and Tests, Single Config Generator, Debug",
            "inherits": "defaults",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "E_FOC_TARGET_PLATFORM": "host",
                "E_FOC_BUILD_TESTS": true
            }
        },
        {
            "name": "windows",
            "displayName": "Cross-compilation Linux → Windows (clang-cl + xwin)",
            "inherits": "defaults",
            "toolchainFile": "${sourceDir}/infra/embedded-infra-lib/cmake/toolchain-clang-x86_64-pc-windows-msvc.cmake",
            "environment": {
                "CCACHE_DEPEND": "true",
                "CCACHE_COMPILERTYPE": "clang-cl"
            },
            "cacheVariables": {
                "CMAKE_COMPILE_WARNING_AS_ERROR": "Off",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo;MinSizeRel",
                "CMAKE_PREFIX_PATH": "/opt/qt6-windows/6.10.2/msvc2022_64",
                "QT_HOST_PATH": "/usr",
                "QT_HOST_PATH_CMAKE_DIR": "/usr/lib/x86_64-linux-gnu/cmake",
                "WINDOWS_SDK_ROOT": "/winsdk",
                "E_FOC_TARGET_PLATFORM": "host",
                "E_FOC_BUILD_TESTS": true,
                "E_FOC_BUILD_HIL_TESTS": true,
                "NUMERICAL_TOOLBOX_ENABLE_OPTIMIZATIONS": false
            },
            "generator": "Ninja Multi-Config"
        },
        {
            "name": "coverage",
            "displayName": "coverage",
            "description": "Configuration for code coverage",
            "inherits": "host",
            "cacheVariables": {
                "EMIL_ENABLE_COVERAGE": "On"
            },
            "generator": "Ninja"
        },
        {
            "name": "embedded",
            "hidden": true,
            "inherits": "defaults",
            "environment": {
                "CMAKE_TOOLCHAIN_FILE": ""
            },
            "cacheVariables": {
                "EMIL_GENERATE_PACKAGE_CONFIG": false,
                "EMIL_INCLUDE_SEGGER_RTT": "On",
                "EMIL_SEGGER_RTT_BUFFER_SIZE_UP": "2048",
                "NUMERICAL_TOOLBOX_ENABLE_OPTIMIZATIONS": true,
                "NUMERICAL_TOOLBOX_ENABLE_CUSTOM_MATH": true,
                "E_FOC_EMBEDDED_BUILD": true
            },
            "generator": "Ninja Multi-Config"
        },
        {
            "name": "tiva",
            "hidden": true,
            "inherits": "embedded",
            "environment": {
                "CMAKE_TOOLCHAIN_FILE": ""
            },
            "cacheVariables": {
                "TARGET_MCU_VENDOR": "ti",
                "E_FOC_TARGET_PLATFORM": "ti"
            }
        },
        {
            "name": "stm32",
            "hidden": true,
            "inherits": "embedded",
            "environment": {
                "CMAKE_TOOLCHAIN_FILE": ""
            },
            "cacheVariables": {
                "TARGET_MCU_VENDOR": "st",
                "E_FOC_TARGET_PLATFORM": "st"
            }
        },
        {
            "name": "EK-TM4C1294XL",
            "displayName": "EK-TM4C1294XL",
            "description": "Build for tm4c1294ncpdt",
            "inherits": "tiva",
            "toolchainFile": "${sourceDir}/infra/embedded-infra-lib/cmake/toolchain-arm-gcc-m4-fpv4-sp-d16.cmake",
            "cacheVariables": {
                "TARGET_CORTEX": "m4",
                "TARGET_MCU_FAMILY": "TM4C129",
                "TARGET_MCU": "tm4c1294ncpdt",
                "E_FOC_TARGET_BOARD": "EK-TM4C1294XL",
                "E_FOC_MOTOR_BOARD": "FRDM-MC-LVPMSM"
            }
        },
        {
            "name": "EK-TM4C123GXL",
            "displayName": "EK-TM4C123GXL",
            "description": "Build for tm4c123gh6pm",
            "inherits": "tiva",
            "toolchainFile": "${sourceDir}/infra/embedded-infra-lib/cmake/toolchain-arm-gcc-m4-fpv4-sp-d16.cmake",
            "cacheVariables": {
                "TARGET_CORTEX": "m4",
                "TARGET_MCU_FAMILY": "TM4C123",
                "TARGET_MCU": "tm4c123gh6pm",
                "E_FOC_TARGET_BOARD": "EK-TM4C123GXL",
                "E_FOC_MOTOR_BOARD": "FRDM-MC-LVPMSM"
            }
        },
        {
            "name": "STM32F407G-DISC1",
            "displayName": "STM32F407G-DISC1",
            "description": "Build for stm32f407",
            "inherits": "stm32",
            "toolchainFile": "${sourceDir}/infra/embedded-infra-lib/cmake/toolchain-arm-gcc-m4-fpv4-sp-d16.cmake",
            "cacheVariables": {
                "TARGET_CORTEX": "m4",
                "TARGET_MCU_FAMILY": "stm32f4xx",
                "TARGET_MCU": "stm32f407",
                "E_FOC_TARGET_BOARD": "STM32F407G-DISC1",
                "E_FOC_MOTOR_BOARD": "FRDM-MC-LVPMSM"
            }
        },
        {
            "name": "NUCLEO-H563ZI",
            "displayName": "NUCLEO-H563ZI",
            "description": "Build for STM32H563ZI",
            "inherits": "stm32",
            "toolchainFile": "${sourceDir}/infra/embedded-infra-lib/cmake/toolchain-arm-gcc-m33-fpv5-sp-d16.cmake",
            "cacheVariables": {
                "TARGET_CORTEX": "m33",
                "TARGET_MCU_FAMILY": "stm32h5xx",
                "TARGET_MCU": "stm32h563",
                "E_FOC_TARGET_BOARD": "NUCLEO-H563ZI",
                "E_FOC_MOTOR_BOARD": "FRDM-MC-LVPMSM"
            }
        },
        {
            "name": "qemu-cortex-m4",
            "displayName": "QEMU Cortex-M4 SIL Tests",
            "description": "Run core unit tests and cycle benchmark on emulated Cortex-M4 (mps2-an386)",
            "inherits": "defaults",
            "toolchainFile": "${sourceDir}/infra/embedded-infra-lib/cmake/toolchain-arm-gcc-m4-fpv4-sp-d16.cmake",
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo",
                "EMIL_BUILD_QEMU": "On",
                "EMIL_BUILD_CORTEX_M": "On",
                "TARGET_CORTEX": "m4",
                "E_FOC_BUILD_TESTS": "On",
                "E_FOC_BUILD_SIMULATOR": "Off",
                "E_FOC_BUILD_HIL_TESTS": "Off",
                "E_FOC_EMBEDDED_BUILD": "On",
                "NUMERICAL_TOOLBOX_ENABLE_OPTIMIZATIONS": "On",
                "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-system-arm;-M;mps2-an386;-nographic;-semihosting-config;enable=on,target=native;-kernel",
                "CMAKE_CXX_FLAGS": "-DGTEST_HAS_STREAM_REDIRECTION=0 -DGTEST_HAS_POSIX_RE=0 -D_POSIX_C_SOURCE=200112L"
            }
        },
        {
            "name": "qemu-cortex-m7",
            "displayName": "QEMU Cortex-M7 SIL Tests",
            "description": "Run core unit tests and cycle benchmark on emulated Cortex-M7 (mps2-an500)",
            "inherits": "defaults",
            "toolchainFile": "${sourceDir}/infra/embedded-infra-lib/cmake/toolchain-arm-gcc-m7-fpv5-d16.cmake",
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo",
                "EMIL_BUILD_QEMU": "On",
                "EMIL_BUILD_CORTEX_M": "On",
                "TARGET_CORTEX": "m7",
                "E_FOC_BUILD_TESTS": "On",
                "E_FOC_BUILD_SIMULATOR": "Off",
                "E_FOC_BUILD_HIL_TESTS": "Off",
                "E_FOC_EMBEDDED_BUILD": "On",
                "NUMERICAL_TOOLBOX_ENABLE_OPTIMIZATIONS": "On",
                "CMAKE_CROSSCOMPILING_EMULATOR": "qemu-system-arm;-M;mps2-an500;-nographic;-semihosting-config;enable=on,target=native;-kernel",
                "CMAKE_CXX_FLAGS": "-DGTEST_HAS_STREAM_REDIRECTION=0 -DGTEST_HAS_POSIX_RE=0 -D_POSIX_C_SOURCE=200112L"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "host-Release",
            "configuration": "Release",
            "configurePreset": "host"
        },
        {
            "name": "host-Release-WithPackage",
            "configuration": "Release",
            "configurePreset": "host",
            "targets": [
                "all",
                "package"
            ]
        },
        {
            "name": "host-RelWithDebInfo",
            "configuration": "RelWithDebInfo",
            "configurePreset": "host"
        },
        {
            "name": "host-Debug",
            "configuration": "Debug",
            "configurePreset": "host"
        },
        {
            "name": "host-Debug-WithPackage",
            "configuration": "Debug",
            "configurePreset": "host",
            "targets": [
                "all",
                "package"
            ]
        },
        {
            "name": "host-single-Debug",
            "configuration": "Debug",
            "configurePreset": "host-single-Debug"
        },
        {
            "name": "windows-RelWithDebInfo",
            "configuration": "RelWithDebInfo",
            "configurePreset": "windows"
        },
        {
            "name": "windows-Debug",
            "configuration": "Debug",
            "configurePreset": "windows"
        },
        {
            "name": "windows-Release",
            "configuration": "Release",
            "configurePreset": "windows"
        },
        {
            "name": "coverage",
            "configuration": "Debug",
            "configurePreset": "coverage"
        },
        {
            "name": "EK-TM4C1294XL-RelWithDebInfo",
            "configuration": "RelWithDebInfo",
            "configurePreset": "EK-TM4C1294XL"
        },
        {
            "name": "EK-TM4C1294XL-Debug",
            "configuration": "Debug",
            "configurePreset": "EK-TM4C1294XL"
        },
        {
            "name": "EK-TM4C123GXL-RelWithDebInfo",
            "configuration": "RelWithDebInfo",
            "configurePreset": "EK-TM4C123GXL"
        },
        {
            "name": "EK-TM4C123GXL-Debug",
            "configuration": "Debug",
            "configurePreset": "EK-TM4C123GXL"
        },
        {
            "name": "STM32F407G-DISC1-RelWithDebInfo",
            "configuration": "RelWithDebInfo",
            "configurePreset": "STM32F407G-DISC1"
        },
        {
            "name": "STM32F407G-DISC1-Debug",
            "configuration": "Debug",
            "configurePreset": "STM32F407G-DISC1"
        },
        {
            "name": "NUCLEO-H563ZI-RelWithDebInfo",
            "configuration": "RelWithDebInfo",
            "configurePreset": "NUCLEO-H563ZI"
        },
        {
            "name": "NUCLEO-H563ZI-Debug",
            "configuration": "Debug",
            "configurePreset": "NUCLEO-H563ZI"
        },
        {
            "name": "qemu-cortex-m4-RelWithDebInfo",
            "configuration": "RelWithDebInfo",
            "configurePreset": "qemu-cortex-m4",
            "targets": [
                "e_foc.foc.transforms_test",
                "e_foc.foc.current_loop_test",
                "e_foc.foc.math_test",
                "e_foc.foc.speed_loop_test",
                "e_foc.foc.position_loop_test",
                "e_foc.foc.selection_test",
                "e_foc.sil_qemu"
            ]
        },
        {
            "name": "qemu-cortex-m7-RelWithDebInfo",
            "configuration": "RelWithDebInfo",
            "configurePreset": "qemu-cortex-m7",
            "targets": [
                "e_foc.foc.transforms_test",
                "e_foc.foc.current_loop_test",
                "e_foc.foc.math_test",
                "e_foc.foc.speed_loop_test",
                "e_foc.foc.position_loop_test",
                "e_foc.foc.selection_test",
                "e_foc.sil_qemu"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "defaults",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            },
            "filter": {
                "exclude": {
                    "label": "integration|hardware"
                }
            }
        },
        {
            "name": "host",
            "configurePreset": "host",
            "configuration": "Debug",
            "inherits": "defaults"
        },
        {
            "name": "coverage",
            "configurePreset": "coverage",
            "configuration": "Debug",
            "inherits": "defaults"
        },
        {
            "name": "host-single-Debug",
            "configurePreset": "host-single-Debug",
            "configuration": "Debug",
            "inherits": "defaults"
        },
        {
            "name": "qemu-cortex-m4",
            "configurePreset": "qemu-cortex-m4",
            "configuration": "RelWithDebInfo",
            "inherits": "defaults"
        },
        {
            "name": "qemu-cortex-m7",
            "configurePreset": "qemu-cortex-m7",
            "configuration": "RelWithDebInfo",
            "inherits": "defaults"
        }
    ]
}
