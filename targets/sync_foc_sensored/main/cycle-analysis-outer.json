{
  "path_name": "Low-priority interrupt -> position loop -> speed loop -> online estimators",
  "loop_rates_khz": [1],
  "loop_bounds": {
    "^foc::SpeedDifferentiator::Measure\\(": 2,
    "^__ieee754_fmodf$": 3,
    "^services::RealTimeFrictionAndInertiaEstimator::SteadyFriction\\(": 2,
    "^services::RealTimeFrictionAndInertiaEstimator::Update\\(": [
      2, 3, 3, 3, 9, 9, 9
    ],
    "^estimators::RecursiveLeastSquares<float, 3u>::Update\\(": [
      3, 3, 3, 9, 9, 9
    ],
    "^services::RealTimeResistanceAndInductanceEstimator::ComputeEstimate\\(": 4,
    "^estimators::RecursiveLeastSquares<float, 2u>::Update\\(": 4
  },
  "path_stages": [
    {
      "label": "LPI Entry (exception overhead)",
      "type": "exception_entry"
    },
    {
      "label": "Interrupt Vector",
      "patterns": [
        "^Default_Handler_Forwarded$",
        "^hal::cortex::LowPriorityInterrupt::Invoke\\(",
        "StaticInvoke<hal::cortex::LowPriorityInterrupt::onInvoke"
      ]
    },
    {
      "label": "FOC Outer Loop (LowPriorityHandler)",
      "combine": "max",
      "patterns": [
        "StaticInvoke<foc::(Speed|Position)Cascade::(Speed|Position)Cascade\\(",
        "^foc::(Speed|Position)Cascade::LowPriorityHandler\\("
      ]
    },
    {
      "label": "Online Mechanical Estimator (RLS)",
      "patterns": [
        "^services::RealTimeFrictionAndInertiaEstimator::Update\\(",
        "^estimators::RecursiveLeastSquares<float, 3u>::(Update|Coefficients)\\("
      ]
    },
    {
      "label": "Online Electrical Estimator (RLS)",
      "patterns": [
        "^services::RealTimeResistanceAndInductanceEstimator::(Update|HasSettled|CurrentResistance|CurrentInductance)\\(",
        "^estimators::RecursiveLeastSquares<float, 2u>::(Update|Coefficients)\\("
      ]
    },
    {
      "label": "Online Flux Linkage Estimator",
      "patterns": [
        "^services::RealTimeFluxLinkageEstimator::(Update|HasSettled|CurrentFluxLinkage)\\("
      ]
    },
    {
      "label": "LPI Exit (exception return)",
      "type": "exception_exit"
    }
  ]
}
