{
    "path_name": "ADC ISR \u2192 FOC Position (worst case: inner + outer loop + all estimators) \u2192 PWM Output",
    "loop_rates_khz": [
        1,
        10,
        20
    ],
    "path_stages": [
        {
            "label": "ISR Entry (exception overhead)",
            "type": "exception_entry"
        },
        {
            "label": "ADC ISR + Callback Dispatch",
            "patterns": [
                "Adc0Sequence.*Handler",
                "InterruptTable::Invoke",
                "ImmediateInterruptHandler::Invoke"
            ]
        },
        {
            "label": "Encoder Read",
            "patterns": [
                "PlatformAdapter::Read",
                "QuadratureEncoderDecorator.*::Read",
                "QuadratureEncoder::Position",
                "QuadratureEncoder::Resolution"
            ]
        },
        {
            "label": "FOC Inner Loop (Calculate)",
            "entry": "PositionCascade::Calculate",
            "patterns": [
                "PositionCascade::Calculate",
                "CascadeWithSpeedLoop::CalculateInnerLoop",
                "Clarke::Forward",
                "Park::Forward",
                "Park::Inverse",
                "SpaceVectorModulation::Generate",
                "SpaceVectorModulation::Clip",
                "FastTrigonometry::Sine",
                "FastTrigonometry::Cosine",
                "PidCurrentController::Compute",
                "DecoupledPidCurrentController::Compute",
                "DeadbeatCurrentController::Compute",
                "SlidingModeCurrentController::Compute",
                "LimitToModulationCircle",
                "PidIncrementalBase.*::Process",
                "PidIncrementalBase.*::Clamp",
                "PidIncrementalSynchronous.*::Process",
                "PidIncrementalSynchronous.*::SetPoint",
                "PositionWithWrapAround",
                "std::array<float.*>::operator\\[\\]",
                "std::clamp",
                "std::max<float>",
                "std::min<float>"
            ]
        },
        {
            "label": "FOC Outer Loop (LowPriorityHandler)",
            "patterns": [
                "PositionCascade::LowPriorityHandler",
                "SpeedCascade::LowPriorityHandler",
                "CascadeWithSpeedLoop::RunSpeedLoop",
                "CascadeWithSpeedLoop::MeasureMechanicalSpeed",
                "CascadeWithSpeedLoop::SetSpeedReference",
                "CascadeWithSpeedLoop::SetDirectCurrentReference",
                "CascadeWithSpeedLoop::CurrentMechanicalAngle",
                "CascadeWithSpeedLoop::PolePairs",
                "PidSpeedController::Compute",
                "LqiSpeedController::Compute",
                "AdrcSpeedController::Compute",
                "TwoDofSpeedController::Compute",
                "PidPositionController::Compute",
                "CascadePPositionController::Compute",
                "LqrPositionController::Compute",
                "LqiPositionController::Compute",
                "TwoDofPositionController::Compute",
                "PidIncrementalSynchronous.*::Process",
                "PidIncrementalSynchronous.*::SetPoint",
                "OuterSamplePeriod",
                "WrappedPositionError",
                "LimitToCurrentEnvelope"
            ]
        },
        {
            "label": "Online Mechanical Estimator (RLS)",
            "required": false,
            "patterns": [
                "CascadeWithSpeedLoop::UpdateOnlineMechanicalEstimator",
                "RealTimeFrictionAndInertiaEstimator::Update",
                "RecursiveLeastSquares.*::Update",
                "ClarkePark::Forward"
            ]
        },
        {
            "label": "Online Electrical Estimator (RLS)",
            "required": false,
            "patterns": [
                "CascadeWithSpeedLoop::UpdateOnlineElectricalEstimator",
                "RealTimeResistanceAndInductanceEstimator::Update",
                "RealTimeResistanceAndInductanceEstimator::ComputeEstimate",
                "RecursiveLeastSquares.*::Update"
            ]
        },
        {
            "label": "PWM Output",
            "patterns": [
                "PlatformAdapter::ThreePhasePwmOutput",
                "SynchronousPwm::Start.*Percent.*Percent.*Percent",
                "SynchronousPwm::SetComparator",
                "SynchronousPwm::Sync"
            ]
        },
        {
            "label": "ISR Exit (exception return)",
            "type": "exception_exit"
        }
    ]
}
