{
  "path_name": "ADC ISR -> FOC inner loop -> mechanical identification observer (window)",
  "loop_rates_khz": [20],
  "path_stages": [
    {
      "label": "ISR Entry (exception overhead)",
      "type": "exception_entry"
    },
    {
      "label": "ADC ISR + Callback Dispatch",
      "required": false,
      "patterns": [
        "Adc0Sequence.*Handler",
        "InterruptTable::Invoke",
        "ImmediateInterruptHandler::Invoke",
        "Default_Handler_Forwarded",
        "hal::cortex::ActiveInterrupt",
        "DmaStm::StreamInterruptHandler::OnInterrupt",
        "DmaStm::StreamInterruptHandler::StreamInterruptHandler.*lambda",
        "AdcDmaMultiChannelStmBase::TransferDone",
        "AdcDmaMultiChannelStmBase::AdcDmaMultiChannelStmBase.*lambda",
        "AdcTriggeredByPwmStm.*::Measure.*lambda",
        "AdcPhaseCurrentMeasurementImpl.*lambda",
        "PlatformFactoryImpl::ReconfigureAdc.*lambda",
        "PlatformFactoryImpl::MonitorBoard",
        "PlatformFactoryImpl::PhaseCurrentsReady.*lambda",
        "InverterCompensation::PhaseCurrentsReady.*lambda",
        "Runner.*::OnPhaseCurrents",
        "ControlLoopMetrics::Record",
        "ControlLoopMetrics::RecordReentry"
      ]
    },
    {
      "label": "FOC Inner Loop (Calculate)",
      "required": false,
      "patterns": [
        "SpeedCascade::Calculate",
        "PositionCascade::Calculate",
        "CascadeWithSpeedLoop::CalculateInnerLoop",
        "Clarke::Forward",
        "Park::Forward",
        "Park::Inverse",
        "SpaceVectorModulation::Generate",
        "SpaceVectorModulation::Clip",
        "FastTrigonometry::Sine",
        "FastTrigonometry::Cosine",
        "PidCurrentController::Compute",
        "DecoupledPidCurrentController::Compute",
        "DeadbeatCurrentController::Compute",
        "SlidingModeCurrentController::Compute",
        "LimitToModulationCircle",
        "ToDutyCycles",
        "CurrentStream::Accumulate",
        "CurrentStream::Reopen",
        "CurrentStream::Publish"
      ]
    },
    {
      "label": "Mechanical Identification Observer (window)",
      "required": false,
      "patterns": [
        "MechanicalParametersIdentificationImpl::OnSamplingUpdate",
        "MechanicalParametersIdentificationImpl::EstimateFrictionAndInertia.*lambda\\(auto:1",
        "ClarkePark::Forward",
        "ExceedsInjectionLimit",
        "PositionWithWrapAround",
        "IsFiniteValue",
        "MechanicalParametersIdentificationImpl::Post",
        "IsMechanicallyObservable"
      ]
    },
    {
      "label": "ISR Exit (exception return)",
      "type": "exception_exit"
    }
  ]
}
