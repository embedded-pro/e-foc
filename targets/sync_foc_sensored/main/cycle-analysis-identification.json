{
  "path_name": "ADC ISR -> FOC inner loop -> PWM output -> calibration observer",
  "loop_rates_khz": [20],
  "loop_bounds": {
    "StaticInvoke<hal::tiva::Adc::Adc\\(": 6,
    "^hal::PwmStmBase::StartImpl\\(": 3,
    "^services::InverterCompensation::ThreePhasePwmOutput\\(": 1,
    "^services::MechanicalParametersIdentificationImpl::ScheduleFit\\(": 2,
    "^memmove$": 12,
    "^memset$": 32
  },
  "cold_calls": [
    "PlatformFactoryImpl::TripOverCurrent",
    "PlatformFactoryImpl::TripProtection",
    "^application::CutPowerStage",
    "^assert_failed$",
    "^ADC_Disable$",
    "^HAL_TIM_GenerateEvent$",
    "MechanicalParametersIdentificationImpl::FailEnvelope"
  ],
  "path_stages": [
    {
      "label": "ISR Entry (exception overhead)",
      "type": "exception_entry"
    },
    {
      "label": "Interrupt Vector",
      "combine": "max",
      "patterns": ["^Adc0Sequence[0-3]_Handler$", "^Default_Handler_Forwarded$"]
    },
    {
      "label": "ADC ISR + Callback Dispatch",
      "patterns": [
        "^hal::cortex::ImmediateInterruptHandler::Invoke\\(",
        "StaticInvoke<hal::tiva::Adc::Adc\\(",
        "StaticInvoke<hal::DmaStm::CircularStreamInterruptHandler::CircularStreamInterruptHandler\\(",
        "^hal::DmaStm::CircularStreamInterruptHandler::OnInterrupt\\(",
        "StaticInvoke<hal::AdcDmaMultiChannelStmBase::AdcDmaMultiChannelStmBase\\(",
        "StaticInvoke<application::AdcTriggeredByPwmStm<.*>::Measure\\(",
        "StaticInvoke<application::PlatformFactoryImpl::ReconfigureAdc\\(",
        "StaticInvoke<application::AdcPhaseCurrentMeasurementImpl<.*>::Measure\\(",
        "StaticInvoke<application::PlatformFactoryImpl::PhaseCurrentsReady\\(",
        "StaticInvoke<services::InverterCompensation::PhaseCurrentsReady\\("
      ]
    },
    {
      "label": "Control Mode Dispatch",
      "combine": "max",
      "patterns": [
        "StaticInvoke<foc::Runner<foc::(Torque|Speed|Position)Cascade>::RegisterPhaseCurrents\\("
      ]
    },
    {
      "label": "Encoder Read",
      "combine": "max",
      "patterns": ["application::PlatformFactoryImpl::Read\\(\\)$"]
    },
    {
      "label": "FOC Inner Loop (Calculate)",
      "patterns": [
        "^foc::TorqueCascade::Calculate\\(",
        "^foc::SpeedCascade::Calculate\\(",
        "^foc::PositionCascade::Calculate\\(",
        "^application::FocLowPriorityInterruptAdapter::Trigger\\("
      ]
    },
    {
      "label": "PWM Output",
      "patterns": [
        "^services::InverterCompensation::ThreePhasePwmOutput\\(",
        "^application::DecimatingThreePhaseInverter::ThreePhasePwmOutput\\(",
        "application::PlatformFactoryImpl::ThreePhasePwmOutput\\(",
        "application::PlatformFactoryImpl::ZeroVectorSlopes\\("
      ]
    },
    {
      "label": "PWM Register Update",
      "combine": "max",
      "patterns": [
        "hal::tiva::Pwm::Start\\(hal::DutyCycle, hal::DutyCycle, hal::DutyCycle\\)$",
        "hal::PwmStm::Start\\(hal::DutyCycle, hal::DutyCycle, hal::DutyCycle\\)$"
      ]
    },
    {
      "label": "Calibration Observer (costliest)",
      "combine": "max",
      "patterns": [
        "InvokerFunctions<void \\(foc::PhaseCurrents const&\\), 8u>::StaticInvoke<services::MechanicalParametersIdentificationImpl::EstimateFrictionAndInertia\\(",
        "InvokerFunctions<void \\(foc::PhaseCurrents const&\\), 8u>::StaticInvoke<services::CoggingMappingImpl::Measure\\("
      ]
    },
    {
      "label": "ISR Exit (exception return)",
      "type": "exception_exit"
    }
  ]
}
