include("${CMAKE_CURRENT_LIST_DIR}/EkTm4c1294xlBoard.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/NucleoG474reBoard.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/NucleoH563ziBoard.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/EmulatedBoard.cmake")

if(E_FOC_TARGET_PLATFORM STREQUAL "qemu")
    set(E_FOC_BOARD EMULATED)
elseif(DEFINED E_FOC_TARGET_BOARD)
    string(MAKE_C_IDENTIFIER "${E_FOC_TARGET_BOARD}" E_FOC_BOARD)
    if(NOT DEFINED E_FOC_${E_FOC_BOARD}_SYMBOL)
        message(FATAL_ERROR "cmake/ has no board definition for ${E_FOC_TARGET_BOARD}")
    endif()
endif()

function(e_foc_add_boards_header target)
    set(E_FOC_TARGET_BOARD_DEFINITION "")
    if(DEFINED E_FOC_BOARD)
        string(APPEND E_FOC_TARGET_BOARD_DEFINITION "\nnamespace e_foc\n{\n")
        string(APPEND E_FOC_TARGET_BOARD_DEFINITION "    inline constexpr const boards::Board& board{ boards::${E_FOC_${E_FOC_BOARD}_SYMBOL} };\n")
        if(DEFINED E_FOC_${E_FOC_BOARD}_DEVICE_FAMILY)
            string(APPEND E_FOC_TARGET_BOARD_DEFINITION "    inline constexpr uint16_t deviceFamily{ ${E_FOC_${E_FOC_BOARD}_DEVICE_FAMILY} };\n")
            string(APPEND E_FOC_TARGET_BOARD_DEFINITION "    inline constexpr uint32_t deviceIdentity{ ${E_FOC_${E_FOC_BOARD}_DEVICE_IDENTITY} };\n")
        endif()
        string(APPEND E_FOC_TARGET_BOARD_DEFINITION "}\n")
    endif()

    set(directory "${CMAKE_CURRENT_BINARY_DIR}/${target}")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/Boards.hpp.in" "${directory}/generated/Boards.hpp" @ONLY)

    add_library(${target} INTERFACE)
    target_include_directories(${target} INTERFACE "$<BUILD_INTERFACE:${directory}>")
endfunction()
