{
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "containerEnv": {
    "DISPLAY": "host.docker.internal:0.0",
    "QT_X11_NO_MITSHM": "1",
    "LIBGL_ALWAYS_INDIRECT": "1",
    "DEBUGINFOD_URLS": ""
  },
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway",
    "--privileged",
    "--shm-size=256m"
  ],
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "JacquesLucke.gcov-viewer@0.5.0",
        "matepek.vscode-catch2-test-adapter@4.12.2",
        "anthropic.claude-code@2.1.162"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.insertFinalNewline": true,
        "gcovViewer.buildDirectories": [
          "${workspaceFolder}/build/Coverage"
        ],
        "gcovViewer.highlightMissedLines": true
      }
    }
  },
  "postCreateCommand": {
    "submodule.update": "git submodule update --init --recursive",
    "config.core.autocrlf": "git config --replace-all core.autocrlf false",
    "config.core.eol": "git config --replace-all core.eol lf"
  }
}
