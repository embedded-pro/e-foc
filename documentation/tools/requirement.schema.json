{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "List of Requirements",
  "type": "array",
  "minItems": 1,
  "definitions": {
    "verificationKind": {
      "type": "string",
      "enum": ["sil", "hil", "mil", "unit", "inspection"]
    }
  },
  "items": {
    "type": "object",
    "required": ["id", "title", "shall", "status", "verification"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^REQ-[A-Z]+-[0-9]{3}$"
      },
      "title": {
        "type": "string",
        "minLength": 3
      },
      "shall": {
        "type": "string",
        "pattern": "(?i)shall"
      },
      "status": {
        "type": "string",
        "enum": ["draft", "implemented", "verified", "retired"]
      },
      "verification": {
        "oneOf": [
          {
            "$ref": "#/definitions/verificationKind"
          },
          {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/definitions/verificationKind"
            }
          }
        ]
      },
      "rationale": {
        "type": "string",
        "minLength": 3
      }
    }
  }
}
